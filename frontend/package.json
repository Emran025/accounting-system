{
  "name": "accore",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 5000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 5000 -H 0.0.0.0",
    "lint": "eslint",
    "format": "prettier --write --ignore-unknown .",
    "test": "vitest run",
    "i18n:inventory": "tsx scripts/i18n-inventory.ts",
    "i18n:check": "tsx scripts/i18n-inventory.ts --check",
    "i18n:coverage": "tsx scripts/i18n-verify-coverage.ts --check",
    "desktop:prepare-server-runtime": "node scripts/prepare-server-runtime.mjs",
    "desktop:build-server-headless-installer": "node scripts/build-server-headless-installer.mjs",
    "desktop:build-server-headless-package": "node scripts/build-server-headless-package.mjs",
    "desktop:build-server-desktop-macos-package": "node scripts/build-server-desktop-macos-package.mjs",
    "desktop:verify-server-headless-installer": "node scripts/verify-server-headless-installer-contract.mjs",
    "desktop:verify-flavor-icons": "node scripts/verify-desktop-flavor-icons.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:server:dev": "cross-env ACCORE_PRODUCT_FLAVOR=server NEXT_PUBLIC_ACCORE_PRODUCT_FLAVOR=server NEXT_PUBLIC_ACCORE_SERVER_API_BASE=http://127.0.0.1:8765/api tauri dev --config src-tauri/tauri.server.conf.json --features server-product",
    "desktop:client:dev": "cross-env ACCORE_PRODUCT_FLAVOR=client NEXT_PUBLIC_ACCORE_PRODUCT_FLAVOR=client tauri dev --config src-tauri/tauri.client.conf.json --features client-product",
    "desktop:server:build": "cross-env ACCORE_PRODUCT_FLAVOR=server NEXT_PUBLIC_ACCORE_PRODUCT_FLAVOR=server NEXT_PUBLIC_ACCORE_SERVER_API_BASE=http://127.0.0.1:8765/api tauri build --config src-tauri/tauri.server.conf.json --features server-product",
    "desktop:client:build": "cross-env ACCORE_PRODUCT_FLAVOR=client NEXT_PUBLIC_ACCORE_PRODUCT_FLAVOR=client tauri build --config src-tauri/tauri.client.conf.json --features client-product"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-process": "2.3.0",
    "@tauri-apps/plugin-stronghold": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.0",
    "@tiptap/extension-color": "^3.30.3",
    "@tiptap/extension-highlight": "^3.30.3",
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-link": "^3.30.3",
    "@tiptap/extension-placeholder": "^3.30.3",
    "@tiptap/extension-table": "^3.30.3",
    "@tiptap/extension-table-cell": "^3.30.3",
    "@tiptap/extension-table-header": "^3.30.3",
    "@tiptap/extension-table-row": "^3.30.3",
    "@tiptap/extension-task-item": "^3.30.3",
    "@tiptap/extension-task-list": "^3.30.3",
    "@tiptap/extension-text-align": "^3.30.3",
    "@tiptap/extension-text-style": "^3.30.3",
    "@tiptap/extension-underline": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@types/qrcode": "^1.5.6",
    "dompurify": "^3.4.14",
    "lucide-react": "^0.562.0",
    "next": "^16.1.6",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vitest": "^4.0.18",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "tailwindcss": "^4",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "ajv": "^6.12.6"
  }
}
