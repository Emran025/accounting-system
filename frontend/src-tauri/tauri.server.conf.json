{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ACCORE ERP Server Desktop",
  "mainBinaryName": "accore-server",
  "identifier": "com.accore.erp.server",
  "app": {
    "windows": [
      {
        "title": "ACCORE ERP Server Desktop",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data: https:; connect-src 'self' http://127.0.0.1:8765 https://127.0.0.1:8765"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "mniWn6BqS8H3ps4NdI9tjTMzIugK7Mxx4Qbgig47WAI=",
      "endpoints": []
    }
  },
  "bundle": {
    "resources": ["resources/server-runtime"],
    "externalBin": ["binaries/accore-server-agent"],
    "icon": [
      "icons/flavors/accore-server.png",
      "icons/flavors/accore-server.icns",
      "icons/flavors/accore-server.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/flavors/accore-server.ico",
        "uninstallerIcon": "icons/flavors/accore-server.ico"
      }
    },
    "linux": {
      "rpm": {
        "compression": {
          "type": "gzip",
          "level": 1
        }
      }
    }
  }
}
