{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ACCORE ERP Client Desktop",
  "mainBinaryName": "accore-client",
  "identifier": "com.accore.erp.client",
  "app": {
    "windows": [
      {
        "title": "ACCORE ERP Client Desktop",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["default", "client-vault"],
      "csp": "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data: https:; connect-src 'self' https:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "mniWn6BqS8H3ps4NdI9tjTMzIugK7Mxx4Qbgig47WAI=",
      "endpoints": []
    }
  },
  "bundle": {
    "icon": [
      "icons/flavors/accore-client.png",
      "icons/flavors/accore-client.icns",
      "icons/flavors/accore-client.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/flavors/accore-client.ico",
        "uninstallerIcon": "icons/flavors/accore-client.ico"
      }
    }
  }
}
